# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's environment variables (Netlify) for the
# deployed site.

# Supabase project powering Sessions and Media (admin studio) — cross-device.
# Project: "Elevation Bible Study" (https://supabase.com/dashboard/project/wnjxyccatwryeteukvol)
SUPABASE_URL=https://wnjxyccatwryeteukvol.supabase.co
# Settings -> API -> Project API keys -> service_role (secret). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password required to open /admin. Leave blank to keep the admin studio open
# with no password (current design-preview behavior).
ADMIN_PASSWORD=
